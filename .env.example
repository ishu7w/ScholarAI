# Required for real student and institution accounts.
# Copy to .env.local and fill with values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# Required for account creation, seeding demo users, and trusted admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-service-role-key

# Optional: AI copilot and resume suggestions.
ANTHROPIC_API_KEY=
